{
	"name": "cf-blog",
	"description": "中文个人博客，Astro 运行时渲染，内容存 Cloudflare D1，站内 /admin 在线编辑（ADR-0009）。",
	"dependencies": {
		"@astrojs/cloudflare": "12.6.12",
		"@fontsource/noto-sans-sc": "^5.3.1",
		"astro": "5.16.9",
		"katex": "^0.16.11",
		"mermaid": "^12.3.0",
		"mermaid-isomorphic": "^3.1.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"shiki": "^4.6.0",
		"typescript": "5.9.3",
		"unified": "^11.0.5"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"playwright": "^1.49.0",
		"wrangler": "4.136.1"
	},
	"engines": {
		"node": ">=22"
	},
	"private": true,
	"scripts": {
		"astro": "astro",
		"build": "astro build",
