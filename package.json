{
	"name": "cf-blog",
	"description": "中文个人博客，Astro 纯静态预渲染，部署于 Cloudflare Workers 静态资源托管。",
	"dependencies": {
		"@astrojs/cloudflare": "12.6.12",
		"@astrojs/mdx": "4.3.13",
		"astro": "5.16.9",
		"katex": "^0.16.11",
		"mermaid-isomorphic": "^3.1.0",
		"rehype-katex": "^7.0.1",
		"remark-math": "^6.0.0",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"@expo-google-fonts/noto-sans-sc": "^0.4.4",
		"@types/node": "^24.19.2",
		"playwright": "^1.49.0",
		"subset-font": "^2.9.0",
		"wrangler": "4.136.1"
	},
	"engines": {
		"node": ">=22"
	},
	"private": true,
	"scripts": {
		"astro": "astro",
		"build": "astro build",
		"cf-typegen": "wrangler types",
		"check": "npm run build && tsc && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "astro dev",
		"fonts": "node scripts/subset-heading-font.mjs",
		"prebuild": "node scripts/subset-heading-font.mjs",
		"predev": "node scripts/subset-heading-font.mjs",
		"preview": "npm run build && wrangler dev"
	},
	"type": "module"
}
