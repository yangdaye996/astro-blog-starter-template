---
interface Props {
	date: Date;
	/** long → 2026年11月8日；short → 2026-11-08（时间轴用，配合等宽数字对齐） */
	variant?: "long" | "short";
	label?: string;
}

const { date, variant = "long", label } = Astro.props;

// 手工格式化而不是用 toLocaleDateString：
// 后者依赖构建机的 ICU 数据，不同环境可能产出不同字符串，破坏构建可重现性。
const pad = (n: number) => String(n).padStart(2, "0");
const y = date.getFullYear();
const m = pad(date.getMonth() + 1);
const d = pad(date.getDate());
const text = variant === "long" ? `${y} 年 ${m} 月 ${d} 日` : `${y}-${m}-${d}`;
---

<time class:list={["formatted-date", variant]} datetime={date.toISOString()}>
	{label && <span class="date-label">{label}</span>}{text}
</time>

<style>
	.formatted-date {
		font-variant-numeric: tabular-nums;
	}
	.short {
		letter-spacing: 0.01em;
	}
	.date-label {
		margin-right: 0.3em;
		color: var(--ink-3);
	}
</style>
