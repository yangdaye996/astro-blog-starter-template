---
import PostCard from "./PostCard.astro";
import EmptyState from "./EmptyState.astro";
import type { Post } from "../lib/db";

interface Props {
	posts: Post[];
	emptyTitle?: string;
	emptyHint?: string;
}

const {
	posts,
	emptyTitle = "还没有文章",
	emptyHint = "到 /admin 新建一篇文章，保存发布后就会出现在这里。",
} = Astro.props;
---

{
	posts.length > 0 ? (
		<div class="card-stream">
			{posts.map((post) => (
				<PostCard post={post} />
			))}
		</div>
	) : (
		<EmptyState title={emptyTitle} hint={emptyHint} />
	)
}
