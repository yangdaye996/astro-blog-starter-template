---
import "../styles/global.css";
import "@fontsource/noto-sans-sc/700.css";
import type { SiteSettings } from "../lib/settings";

interface Props {
	settings: SiteSettings;
	title: string;
	description?: string;
	image?: string;
}

const { settings, title, description = settings.description, image } = Astro.props;

const siteOrigin = Astro.site ?? new URL(settings.url);
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const fullTitle = title === settings.title ? title : `${title} · ${settings.title}`;
// 无封面图时不输出 og:image，避免像模板那样回退到一张占位图
const ogImage = image ? new URL(image, siteOrigin) : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />

<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={settings.author} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:site_name" content={settings.title} />
{ogImage && <meta property="og:image" content={ogImage} />}

<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
