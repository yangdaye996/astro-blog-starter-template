---
import SocialLinks from "./SocialLinks.astro";
import { SITE } from "../consts";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-inner">
		<p class="copyright">
			&copy; {year} {SITE.author} · {SITE.title}
		</p>
		<SocialLinks />
		<p class="colophon">由 Astro 静态生成，托管于 Cloudflare Workers</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--line);
		background: var(--surface);
	}
	.footer-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		padding-block: 2.25rem 2.75rem;
		text-align: center;
	}
	.copyright,
	.colophon {
		margin: 0;
		color: var(--ink-3);
		font-size: 0.8125rem;
	}
	.colophon {
		font-size: 0.75rem;
		opacity: 0.8;
	}
</style>
