---
import HeaderLink from "./HeaderLink.astro";
import SocialLinks from "./SocialLinks.astro";
import { SITE, NAV } from "../consts";
---

<header class="site-header">
	<div class="container header-inner">
		<a class="site-title" href="/" rel="home">{SITE.title}</a>
		<nav class="site-nav" aria-label="主导航">
			{NAV.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
		</nav>
		<div class="header-social">
			<SocialLinks />
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(255, 255, 255, 0.92);
		border-bottom: 1px solid var(--line);
		backdrop-filter: saturate(180%) blur(8px);
	}
	.header-inner {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		min-height: 3.5rem;
	}
	.site-title {
		flex: 0 0 auto;
		color: var(--ink);
		font-family: var(--font-heading);
		font-size: 1.0625rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		white-space: nowrap;
	}
	.site-title:hover {
		color: var(--accent);
	}
	.site-nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin-right: auto;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.site-nav::-webkit-scrollbar {
		display: none;
	}
	.header-social {
		flex: 0 0 auto;
	}
	@media (max-width: 860px) {
		.header-social {
			display: none;
		}
	}
	@media (max-width: 480px) {
		.header-inner {
			gap: 0.9rem;
		}
		.site-title {
			font-size: 1rem;
		}
	}
</style>
