---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmptyState from "../components/EmptyState.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getSiteSettings } from "../lib/settings";
import { listNotes, type Note } from "../lib/db";
import { groupByYear } from "../utils/timeline";

const settings = await getSiteSettings(Astro.locals);
const notes = await listNotes(Astro.locals.runtime!.env.DB, "published");
const groups = groupByYear(notes, (n) => n.date);
---

<BaseLayout settings={settings} title="随想" description={`共 ${notes.length} 条随想，按时间倒序排列。`}>
	<div class="container container-narrow">
		<header class="page-head">
			<h1>随想</h1>
			<p>不成文的短记录，共 {notes.length} 条</p>
		</header>

		{
			notes.length > 0 ? (
				<div class="timeline">
					{groups.map((group) => (
						<section class="timeline-group">
							<h2 class="timeline-year">
								{group.year} 年<span class="timeline-count">{group.entries.length} 条</span>
							</h2>
							{group.entries.map((note: Note) => (
								<article class="note-card">
									<div class="meta-row">
										<FormattedDate date={note.date} />
										{note.tags.length > 0 && (
											<>
												<span class="sep" aria-hidden="true">·</span>
												<ul class="tag-list">
													{note.tags.map((tag) => (
														<li>
															<span class="badge badge-plain">#{tag}</span>
														</li>
													))}
												</ul>
											</>
										)}
									</div>
									{/* 正文是保存时渲染好的成品 HTML（ADR-0009） */}
									<div class="note-body prose" set:html={note.html} />
								</article>
							))}
						</section>
					))}
				</div>
			) : (
				<EmptyState
					title="还没有随想"
					hint="到 /admin 写一条随想，保存发布后会出现在这条时间轴上。"
				/>
			)
		}
	</div>
</BaseLayout>

<style>
	.note-card {
		margin-left: 0;
	}
	.note-card::before {
		content: "";
		position: absolute;
		left: calc(-1.5rem + 1px);
		top: 1.35rem;
		width: 7px;
		height: 7px;
		background: var(--surface);
		border: 2px solid var(--line-strong);
		border-radius: 50%;
	}
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.timeline-year .timeline-count {
		margin-left: 0.6rem;
	}
	@media (max-width: 720px) {
		.note-card::before {
			left: calc(-1.15rem + 1px);
		}
	}
</style>
