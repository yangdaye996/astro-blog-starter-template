---
import "../styles/prose.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import EmptyState from "../components/EmptyState.astro";
import { getSiteSettings } from "../lib/settings";

const settings = await getSiteSettings(Astro.locals);
---

<BaseLayout settings={settings} title="关于" description={`关于 ${settings.author} 与 ${settings.title}。`}>
	<div class="container container-narrow">
		<header class="page-head">
			<h1>关于</h1>
			<p>{settings.author}</p>
		</header>

		{
			settings.aboutHtml ? (
				<div class="prose">
					{/* 编辑器「站点设置」里保存的成品 HTML（保存时渲染，ADR-0009） */}
					<div set:html={settings.aboutHtml} />
					<h2 id="about-contact">联系方式</h2>
					<SocialLinks social={settings.social} />
				</div>
			) : (
				<div class="prose">
					<EmptyState
						title="关于页还没有内容"
						hint="到 /admin 的「站点设置」里写一段关于页正文，保存后立即生效。"
					/>
					<h2 id="about-contact">联系方式</h2>
					<SocialLinks social={settings.social} />
				</div>
			)
		}
	</div>
</BaseLayout>
