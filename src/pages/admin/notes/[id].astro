---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import EditorForm from "../../../components/admin/EditorForm.astro";
import { getNoteById } from "../../../lib/db";

const { id } = Astro.params;
const note = id ? await getNoteById(Astro.locals.runtime!.env.DB, Number(id)) : null;

if (!note) {
	return new Response(null, { status: 404 });
}

const initial = {
	mode: "note" as const,
	id: note.id,
	tags: note.tags,
	status: note.status,
	date: note.date.toISOString().slice(0, 10),
	markdown: note.markdown,
};
---

<AdminLayout title="编辑随想" current="notes">
	<EditorForm mode="note" heading={`编辑随想 #${note.id}`} initial={initial} />
</AdminLayout>
