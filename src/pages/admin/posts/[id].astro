---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import EditorForm from "../../../components/admin/EditorForm.astro";
import { getPostById } from "../../../lib/db";

const { id } = Astro.params;
const post = id ? await getPostById(Astro.locals.runtime!.env.DB, Number(id)) : null;

if (!post) {
	return new Response(null, { status: 404 });
}

// 传给编辑器的初始数据：markdown 供再编辑，日期只取到天（date input 的精度）
const initial = {
	mode: "post" as const,
	id: post.id,
	slug: post.slug,
	title: post.title,
	description: post.description,
	category: post.category ?? "",
	tags: post.tags,
	heroImage: post.heroImage ?? "",
	status: post.status,
	pubDate: post.pubDate.toISOString().slice(0, 10),
	markdown: post.markdown,
};
---

<AdminLayout title={`编辑：${post.title || post.slug}`} current="posts">
	<EditorForm mode="post" heading={`编辑文章 #${post.id}`} initial={initial} />
</AdminLayout>
