---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmptyState from "../components/EmptyState.astro";
import { getSiteSettings } from "../lib/settings";

const settings = await getSiteSettings(Astro.locals);
---

<BaseLayout settings={settings} title="页面不存在">
	<div class="container container-narrow">
		<EmptyState
			title="404 · 页面不存在"
			hint="地址可能有误，或者这篇文章还是草稿、尚未发布。"
		>
			<p class="back-home"><a href="/">回首页看看</a></p>
		</EmptyState>
	</div>
</BaseLayout>

<style>
	.back-home {
		margin: 0.75rem 0 0;
		font-size: 0.875rem;
	}
</style>
