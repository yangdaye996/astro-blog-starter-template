---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmptyState from "../components/EmptyState.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getSiteSettings } from "../lib/settings";
import { listPosts } from "../lib/db";
import { groupByYear } from "../utils/timeline";

const settings = await getSiteSettings(Astro.locals);
const posts = await listPosts(Astro.locals.runtime!.env.DB, "published");
const groups = groupByYear(posts, (p) => p.pubDate);
---

<BaseLayout settings={settings} title="归档" description={`按年份浏览全部 ${posts.length} 篇文章。`}>
	<div class="container container-narrow">
		<header class="page-head">
			<h1>归档</h1>
			<p>共 {posts.length} 篇文章 · 跨 {groups.length} 个年份</p>
		</header>

		{
			groups.length > 0 ? (
				<div class="timeline">
					{groups.map((group) => (
						<section class="timeline-group">
							<h2 class="timeline-year">
								{group.year} 年<span class="timeline-count">{group.entries.length} 篇</span>
							</h2>
							<ul class="timeline-list">
								{group.entries.map((post) => (
									<li class="timeline-item">
										<span class="timeline-date">
											<FormattedDate date={post.pubDate} variant="short" />
										</span>
										<a class="timeline-title" href={`/blog/${post.slug}/`}>
											{post.title}
										</a>
									</li>
								))}
							</ul>
						</section>
					))}
				</div>
			) : (
				<EmptyState
					title="归档还是空的"
					hint="发布第一篇文章后，这里会按年份自动生成时间轴。"
				/>
			)
		}
	</div>
</BaseLayout>

<style>
	.timeline-year .timeline-count {
		margin-left: 0.6rem;
	}
</style>
