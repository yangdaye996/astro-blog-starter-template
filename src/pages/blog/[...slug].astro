---
import { getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { sortDescBy, neighbours, resolvePost, type ResolvedPost } from "../../utils/posts";

export async function getStaticPaths() {
	const posts = (await getCollection("blog")).map(resolvePost);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

interface Props {
	post: ResolvedPost;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const all = sortDescBy((await getCollection("blog")).map(resolvePost), (p) => p.data.pubDate);
const { prev, next } = neighbours(all, post.id);
---

<BlogPost post={post} headings={headings} prev={prev} next={next}>
	<Content />
</BlogPost>
