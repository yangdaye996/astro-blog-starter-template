---
import BlogPost from "../../layouts/BlogPost.astro";
import { getSiteSettings } from "../../lib/settings";
import { getPostBySlug, postNeighbours } from "../../lib/db";

// 运行时渲染（ADR-0009）：不再有 getStaticPaths，按请求从 D1 取数。
// 草稿与不存在的 slug 一律 404，不泄露草稿的存在。
const { slug } = Astro.params;
const settings = await getSiteSettings(Astro.locals);
const db = Astro.locals.runtime!.env.DB;

const post = slug ? await getPostBySlug(db, slug) : null;
if (!post || post.status !== "published") {
	return new Response(null, { status: 404 });
}

const { prev, next } = await postNeighbours(db, post);
---

<BlogPost settings={settings} post={post} prev={prev} next={next} />
