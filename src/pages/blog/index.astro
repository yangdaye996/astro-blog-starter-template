---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import { sortDescBy } from "../../utils/posts";

const posts = sortDescBy(await getCollection("blog"), (p) => p.data.pubDate);

// 构建期汇总分类与标签的出现次数，芯片上的计数因此是静态的、无脚本也能看到
function tally(values: string[]): [string, number][] {
	const map = new Map<string, number>();
	for (const value of values) {
		if (!value) continue;
		map.set(value, (map.get(value) ?? 0) + 1);
	}
	return [...map.entries()].sort(
		(a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "zh-CN"),
	);
}

const categories = tally(posts.map((p) => p.data.category ?? ""));
const tags = tally(posts.flatMap((p) => p.data.tags));
const hasFilters = categories.length + tags.length > 0;
---

<BaseLayout title="文章" description={`全部 ${posts.length} 篇文章，可按分类与标签筛选。`}>
	<div class="container">
		<header class="page-head">
			<h1>文章</h1>
			<p>共 {posts.length} 篇{hasFilters && " · 点击下方分类或标签即可筛选"}</p>
		</header>

		{
			hasFilters && (
				<div class="filter-bar" id="filter-bar">
					{categories.length > 0 && (
						<div class="filter-group" data-group="cat">
							<span class="filter-label">分类</span>
							{categories.map(([name, count]) => (
								<button type="button" class="chip" data-type="cat" data-value={name} aria-pressed="false">
									{name}
									<span class="chip-count">{count}</span>
								</button>
							))}
						</div>
					)}
					{tags.length > 0 && (
						<div class="filter-group" data-group="tag">
							<span class="filter-label">标签</span>
							{tags.map(([name, count]) => (
								<button type="button" class="chip" data-type="tag" data-value={name} aria-pressed="false">
									#{name}
									<span class="chip-count">{count}</span>
								</button>
							))}
						</div>
					)}
					<button type="button" class="chip chip-clear" id="filter-clear" hidden>
						清除筛选
					</button>
				</div>
			)
		}

		<PostList posts={posts} />
		<p class="filter-empty" id="filter-empty" hidden>没有符合当前筛选条件的文章。</p>
	</div>

	<script>
		// 列表页前端筛选（ADR-0006）：不建聚合路由，所有文章元数据已在构建期内联进 DOM，
		// 这里只做显示/隐藏，不发任何请求。筛选状态写入 URL 查询参数，使结果可分享、可后退。
		const bar = document.getElementById("filter-bar");

		if (bar) {
			const cards = Array.from(document.querySelectorAll<HTMLElement>(".post-card"));
			const chips = Array.from(bar.querySelectorAll<HTMLButtonElement>(".chip[data-type]"));
			const clearBtn = document.getElementById("filter-clear") as HTMLButtonElement | null;
			const emptyMsg = document.getElementById("filter-empty");

			const params = new URLSearchParams(location.search);
			let activeCat = params.get("cat") ?? "";
			let activeTag = params.get("tag") ?? "";

			const apply = () => {
				let shown = 0;
				for (const card of cards) {
					const okCat = !activeCat || card.dataset.category === activeCat;
					const okTag = !activeTag || (card.dataset.tags ?? "").split("|").includes(activeTag);
					const ok = okCat && okTag;
					card.hidden = !ok;
					if (ok) shown++;
				}

				for (const chip of chips) {
					const pressed =
						chip.dataset.type === "cat"
							? chip.dataset.value === activeCat
							: chip.dataset.value === activeTag;
					chip.setAttribute("aria-pressed", String(pressed));
				}

				const dirty = Boolean(activeCat || activeTag);
				if (clearBtn) clearBtn.hidden = !dirty;
				if (emptyMsg) emptyMsg.hidden = shown > 0;

				const next = new URLSearchParams();
				if (activeCat) next.set("cat", activeCat);
				if (activeTag) next.set("tag", activeTag);
				const qs = next.toString();
				history.replaceState(null, "", qs ? `${location.pathname}?${qs}` : location.pathname);
			};

			for (const chip of chips) {
				chip.addEventListener("click", () => {
					const { type, value } = chip.dataset;
					if (type === "cat") activeCat = activeCat === value ? "" : value!;
					else activeTag = activeTag === value ? "" : value!;
					apply();
				});
			}

			clearBtn?.addEventListener("click", () => {
				activeCat = "";
				activeTag = "";
				apply();
			});

			apply();
		}
	</script>
</BaseLayout>
