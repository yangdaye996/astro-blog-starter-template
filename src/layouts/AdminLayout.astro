---
// 编辑器后台布局（ADR-0009）。生产环境由 Cloudflare Access 在边缘拦截 /admin/*；
// 本地开发（localhost）不经 Access，属预期行为。
import "../styles/global.css";
import "../styles/prose.css";
import "katex/dist/katex.min.css";
import "../styles/admin.css";

interface Props {
	title: string;
	current?: "home" | "posts" | "notes" | "settings";
}

const { title, current } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} · 编辑器</title>
	</head>
	<body>
		<div class="admin-shell">
			<div class="admin-topbar">
				<a class="brand" href="/admin">编辑器</a>
				<nav aria-label="编辑器导航">
					<a href="/admin" aria-current={current === "home" ? "page" : undefined}>内容列表</a>
					<a href="/admin/posts/new" aria-current={current === "posts" ? "page" : undefined}>新文章</a>
					<a href="/admin/notes/new" aria-current={current === "notes" ? "page" : undefined}>新随想</a>
					<a href="/admin/settings" aria-current={current === "settings" ? "page" : undefined}>站点设置</a>
				</nav>
				<span class="spacer"></span>
				<a class="view-site" href="/">← 查看站点</a>
			</div>
			<main>
				<slot />
			</main>
		</div>
	</body>
</html>
