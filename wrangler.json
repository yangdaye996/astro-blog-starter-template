{
	"name": "astro-blog-starter-template",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "blog",
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
